#!/usr/bin/env bash

set -eu

nixArgs=()

if [ -v NIX_SHOW_TRACE ]; then
    nixArgs+=(--show-trace)
fi

function is_debug_mode {
    [ -v NIX_DEBUG ] || [ -v NFS_VERBOSE ]
}

if is_debug_mode; then
    export NIX_DEBUG NFS_VERBOSE
fi

function echo_debug {
    if is_debug_mode; then
        echo "$@" >&2
    fi
}

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
SCRIPT="$1"; shift

store_path=$(
{
    echo "with (builtins.getFlake \"$SCRIPT_DIR\");"
    printf 'let wrapper = lib.${builtins.currentSystem}.mkWrapper "%s";' "$(realpath "$SCRIPT")"
    if is_debug_mode; then
        echo "in wrapper.metadataJSON"
    else
        echo "in wrapper"
    fi
} | nix build -f - --no-link --print-out-paths ${nixArgs[@]}
)

echo_debug run "$store_path" "$SCRIPT" "$@"
if is_debug_mode; then
    cat "$store_path" | jq
else
    "$store_path" "$SCRIPT" "$@"
fi

